NODE_ENV=development
PORT=8080

# PostgreSQL connection strings
# Default matches the Docker Compose database (docker compose up -d from the repo root)
DATABASE_URL_DEV=postgresql://gobi:gobi@localhost:5433/gobi_mvp_dev

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TIME=15m
JWT_REFRESH_TIME=30d

# Document files (Cloudinary). Files are stored privately and viewed via 5-minute signed links.
# Without these, document uploads return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (Brevo transactional API). Without these, emails are skipped.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-domain
BREVO_SENDER_NAME=Gobi
# Links in emails open this web app
WEB_APP_URL=http://localhost:3000
# Optional: public host for email images (the logo) when WEB_APP_URL is localhost,
# e.g. the deployed web app. Mail clients cannot load images from localhost.
EMAIL_ASSET_URL=
# Development/demo only: deliver every email to one inbox (seeded @gobi.rw accounts cannot receive mail)
EMAIL_REDIRECT_TO=
# Set to false to turn email off entirely
EMAIL_ENABLED=true
