NODE_ENV=test

# Separate database used only by the automated test suite
# Default matches the Docker Compose database (docker compose up -d from the repo root)
DATABASE_URL_TEST=postgresql://gobi:gobi@localhost:5433/gobi_mvp_test

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_TIME=15m
JWT_REFRESH_TIME=30d
