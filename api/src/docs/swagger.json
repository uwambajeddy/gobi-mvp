{
  "openapi": "3.0.3",
  "info": {
    "title": "Gobi MVP API: Operational Shipment Coordination",
    "version": "2.0.0",
    "description": "REST API for the Gobi MVP, an operational coordination platform for logistics companies managing domestic and cross-border freight. Shipments carry one lifecycle, one structured event timeline, a required-documents checklist with a Document Gate, a driver/vehicle Compliance Gate with audited overrides, a payments ledger, exception management and an immutable audit trail."
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "tags": [
    { "name": "Auth", "description": "Registration, login and token refresh" },
    { "name": "Profile", "description": "Current user profile" },
    { "name": "Organizations", "description": "Company workspaces, members and roles" },
    { "name": "Shipments", "description": "Shipment lifecycle and award flow" },
    { "name": "Documents", "description": "Required-documents checklist and verification" },
    { "name": "Assignment", "description": "Vehicle & driver assignment with gates" },
    { "name": "Events", "description": "Structured operational timeline" },
    { "name": "Payments", "description": "Operational payments ledger" },
    { "name": "Exceptions", "description": "Incident management" },
    { "name": "Fleet", "description": "Transport organization vehicles" },
    { "name": "Driver", "description": "Driver licence submission" },
    { "name": "Admin", "description": "Platform administration & audit" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "activeOrg": {
        "name": "x-organization-id",
        "in": "header",
        "required": false,
        "schema": { "type": "integer" },
        "description": "Acting organization for multi-org users; defaults to the caller's only membership."
      },
      "shipmentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" },
        "description": "Shipment id"
      }
    },
    "schemas": {
      "ShipmentStatus": {
        "type": "string",
        "enum": [
          "draft",
          "submitted",
          "quote_approved",
          "awaiting_documents",
          "documents_complete",
          "execution_assigned",
          "in_transit",
          "arrived",
          "delivered",
          "completed",
          "cancelled"
        ]
      },
      "CompanyType": {
        "type": "string",
        "enum": ["distribution", "transport", "clearing_agent"]
      },
      "OrgRole": { "type": "string", "enum": ["owner", "coordinator", "member", "driver"] },
      "Shipment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "reference": { "type": "string", "example": "GB-2026-0002" },
          "title": { "type": "string" },
          "distributionOrgId": { "type": "integer" },
          "transportOrgId": { "type": "integer", "nullable": true },
          "clearingAgentOrgId": { "type": "integer", "nullable": true },
          "assignedDriverId": { "type": "integer", "nullable": true },
          "assignedVehicleId": { "type": "integer", "nullable": true },
          "originAddress": { "type": "string" },
          "destinationAddress": { "type": "string" },
          "isCrossBorder": { "type": "boolean" },
          "recipientName": { "type": "string" },
          "recipientPhone": { "type": "string" },
          "quoteAmount": { "type": "number", "nullable": true },
          "status": { "$ref": "#/components/schemas/ShipmentStatus" },
          "podRecipientName": { "type": "string", "nullable": true },
          "podCapturedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ShipmentDocument": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "docType": { "type": "string", "example": "commercial_invoice" },
          "label": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "status": { "type": "string", "enum": ["required", "uploaded", "verified", "rejected"] },
          "fileName": { "type": "string", "nullable": true },
          "hasFile": { "type": "boolean", "description": "A file is stored; fetch it via /shipments/documents/{docId}/file" },
          "fileMimeType": { "type": "string", "nullable": true },
          "fileSize": { "type": "integer", "nullable": true },
          "rejectionReason": { "type": "string", "nullable": true },
          "expiresAt": { "type": "string", "format": "date", "nullable": true }
        }
      },
      "ShipmentEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "eventType": { "type": "string", "example": "border_cleared" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "locationName": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "source": { "type": "string", "enum": ["manual", "system"] },
          "actorUserId": { "type": "integer", "nullable": true }
        }
      },
      "GateResult": {
        "type": "object",
        "properties": {
          "passed": { "type": "boolean" },
          "missing": { "type": "array", "items": { "type": "object" } },
          "failures": { "type": "array", "items": { "type": "object" } },
          "warnings": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "fail" },
          "message": { "type": "string" }
        }
      }
    },
    "responses": {
      "Unauthorized": { "description": "Missing or invalid access token" },
      "Forbidden": { "description": "Caller is not permitted (role, company type or party check failed)" },
      "NotFound": { "description": "Resource not found" },
      "BadRequest": { "description": "Validation error or invalid lifecycle transition" }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Start a sign-up; the account is created once the email is verified",
        "description": "Emails a 6-digit code and returns a `verification` handle for POST /auth/verify-email; no account exists yet. With an `inviteToken` for the same email, the invitation proves the inbox and the `user` is created at once (sign in to get tokens). Organization membership is granted separately.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstName", "lastName", "email", "password"],
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phoneNumber": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 },
                  "inviteToken": { "type": "string", "description": "Token from an emailed invitation link" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "`verification` { id, email, expiresAt, resendAvailableAt }, or `user` when created from an invitation" },
          "409": { "description": "Email in use" }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirm the emailed code and create the account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["verificationId", "code"],
                "properties": {
                  "verificationId": { "type": "string" },
                  "code": { "type": "string", "pattern": "^\\d{6}$" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User + token pair" },
          "400": { "description": "Wrong code (the message says how many tries are left)" },
          "404": { "description": "Sign-up expired or already completed" },
          "409": { "description": "Another sign-up for this email finished first" },
          "429": { "description": "Five wrong codes; request a new one" }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "tags": ["Auth"],
        "summary": "Email a new code for a pending sign-up (at most every 30 seconds)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["verificationId"], "properties": { "verificationId": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "New code sent; the old one stops working" },
          "404": { "description": "Sign-up expired or already completed" },
          "429": { "description": "Asked again too soon" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in; response includes organization memberships",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "User + memberships + token pair" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/v1/auth/refreshToken": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new access token",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } }
            }
          }
        },
        "responses": { "200": { "description": "New access token" } }
      }
    },
    "/api/v1/profile": {
      "get": { "tags": ["Profile"], "summary": "Current user profile", "responses": { "200": { "description": "User" } } },
      "patch": { "tags": ["Profile"], "summary": "Update profile", "responses": { "200": { "description": "Updated user" } } }
    },
    "/api/v1/organizations": {
      "post": {
        "tags": ["Organizations"],
        "summary": "Create an organization (creator becomes owner)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "companyType"],
                "properties": {
                  "name": { "type": "string" },
                  "companyType": { "$ref": "#/components/schemas/CompanyType" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Organization" } }
      },
      "get": {
        "tags": ["Organizations"],
        "summary": "Directory of organizations (used to pick carriers / clearing agents)",
        "parameters": [
          { "name": "companyType", "in": "query", "schema": { "$ref": "#/components/schemas/CompanyType" } }
        ],
        "responses": { "200": { "description": "Organizations" } }
      }
    },
    "/api/v1/organizations/mine": {
      "get": { "tags": ["Organizations"], "summary": "Caller's memberships", "responses": { "200": { "description": "Memberships with organizations" } } }
    },
    "/api/v1/organizations/{id}/members": {
      "get": {
        "tags": ["Organizations"],
        "summary": "List members (members only)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Members" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Organizations"],
        "summary": "Add someone by email (owner/coordinator): existing users join now, others get an emailed invitation",
        "description": "Responds with `member` when the email has a Gobi account, or `invitation` (plus `resent`) when it doesn't. Repeating it for an open invitation sends a fresh link and updates the role. Only an owner can add or invite another owner (403 for coordinators).",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "role"],
                "properties": {
                  "email": { "type": "string" },
                  "role": { "$ref": "#/components/schemas/OrgRole" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Membership created, or invitation sent" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "description": "Already a member" }
        }
      }
    },
    "/api/v1/organizations/{id}/invitations": {
      "get": {
        "tags": ["Organizations"],
        "summary": "Open invitations, pending or expired (owner/coordinator)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Invitations" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/organizations/{id}/invitations/{invitationId}": {
      "delete": {
        "tags": ["Organizations"],
        "summary": "Revoke an open invitation (owner/coordinator)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "invitationId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Revoked; the link stops working" },
          "400": { "description": "Already accepted or revoked" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Invitation not found" }
        }
      }
    },
    "/api/v1/invitations/{token}": {
      "get": {
        "tags": ["Organizations"],
        "summary": "Public preview of an emailed invitation link",
        "security": [],
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Invitation (organization, role, inviter, status) and whether the email already has an account" },
          "404": { "description": "Unknown or replaced link" }
        }
      }
    },
    "/api/v1/invitations/{token}/accept": {
      "post": {
        "tags": ["Organizations"],
        "summary": "Accept an invitation (signed in with the invited email)",
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Joined; returns the membership" },
          "400": { "description": "Expired or revoked" },
          "403": { "description": "Signed in with a different email" },
          "404": { "description": "Unknown or replaced link" },
          "409": { "description": "Already accepted" }
        }
      }
    },
    "/api/v1/shipments": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Create a draft shipment (distribution org members)",
        "parameters": [{ "$ref": "#/components/parameters/activeOrg" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "originAddress", "destinationAddress", "packages"],
                "properties": {
                  "title": { "type": "string" },
                  "originAddress": { "type": "string" },
                  "destinationAddress": { "type": "string" },
                  "isCrossBorder": { "type": "boolean", "default": false },
                  "recipientName": { "type": "string" },
                  "recipientPhone": { "type": "string" },
                  "packages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["description", "weightKg"],
                      "properties": {
                        "description": { "type": "string" },
                        "weightKg": { "type": "number" },
                        "quantity": { "type": "integer", "default": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Draft shipment with generated reference" } }
      },
      "get": {
        "tags": ["Shipments"],
        "summary": "Shipments visible to the caller (party orgs via owner/coordinator/member roles; drivers see only their own assignments; admins see all)",
        "parameters": [{ "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/ShipmentStatus" } }],
        "responses": { "200": { "description": "Shipments" } }
      }
    },
    "/api/v1/shipments/{id}": {
      "get": {
        "tags": ["Shipments"],
        "summary": "Full workspace aggregate: shipment, documents, exceptions, caller's access context",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Aggregate" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "patch": {
        "tags": ["Shipments"],
        "summary": "Edit a draft (shipper only)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Updated shipment" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/v1/shipments/{id}/submit": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Submit a draft (draft → submitted)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Submitted" } }
      }
    },
    "/api/v1/shipments/{id}/cancel": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Cancel before transit (shipper coordinator)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Cancelled" }, "400": { "description": "No longer cancellable" } }
      }
    },
    "/api/v1/shipments/{id}/assign-carrier": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Assign the transport company (shipper coordinator). Changing the carrier clears the previous carrier's quote.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["transportOrgId"], "properties": { "transportOrgId": { "type": "integer" } } }
            }
          }
        },
        "responses": { "200": { "description": "Carrier assigned" } }
      }
    },
    "/api/v1/shipments/{id}/assign-clearing-agent": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Assign the clearing agent (shipper coordinator)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["clearingAgentOrgId"], "properties": { "clearingAgentOrgId": { "type": "integer" } } }
            }
          }
        },
        "responses": { "200": { "description": "Clearing agent assigned" } }
      }
    },
    "/api/v1/shipments/{id}/quote": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Submit a quotation (assigned carrier coordinator)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["amount"], "properties": { "amount": { "type": "number" }, "currency": { "type": "string", "default": "RWF" } } }
            }
          }
        },
        "responses": { "200": { "description": "Quote stored" } }
      }
    },
    "/api/v1/shipments/{id}/approve-quote": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Approve the quote and seed the required-documents checklist (submitted → awaiting_documents)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Approved; checklist created" } }
      }
    },
    "/api/v1/shipments/{id}/documents": {
      "get": {
        "tags": ["Documents"],
        "summary": "Checklist + live Document Gate result",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": {
          "200": {
            "description": "Documents + gate",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "documents": { "type": "array", "items": { "$ref": "#/components/schemas/ShipmentDocument" } }, "gate": { "$ref": "#/components/schemas/GateResult" } } } } }
          }
        }
      },
      "post": {
        "tags": ["Documents"],
        "summary": "Upload a document file against the checklist (any party org member, or the assigned driver)",
        "description": "Multipart upload. The file (PDF, JPG or PNG, max 10 MB, checked by content) is stored privately in Cloudinary.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["docType", "file"],
                "properties": {
                  "docType": { "type": "string" },
                  "file": { "type": "string", "format": "binary" },
                  "expiresAt": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Uploaded; documents phase auto-syncs" },
          "400": { "description": "No file, unsupported type, content mismatch or over 10 MB" },
          "502": { "description": "The file could not be stored" },
          "503": { "description": "File storage is not configured" }
        }
      }
    },
    "/api/v1/shipments/documents/{docId}/file": {
      "get": {
        "tags": ["Documents"],
        "summary": "Short-lived link to view a stored document file (any shipment party)",
        "parameters": [{ "name": "docId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Signed link, valid for 5 minutes",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "expiresAt": { "type": "string", "format": "date-time" }, "fileName": { "type": "string" }, "mimeType": { "type": "string" }, "fileSize": { "type": "integer" } } } } }
          },
          "403": { "description": "Not a party to the shipment" },
          "404": { "description": "Document not found, or no file stored" }
        }
      }
    },
    "/api/v1/shipments/documents/{docId}/verify": {
      "patch": {
        "tags": ["Documents"],
        "summary": "Verify an uploaded document (carrier coordinator)",
        "parameters": [{ "name": "docId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Verified" } }
      }
    },
    "/api/v1/shipments/documents/{docId}/reject": {
      "patch": {
        "tags": ["Documents"],
        "summary": "Reject with a reason; may regress documents_complete → awaiting_documents",
        "parameters": [{ "name": "docId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string" } } }
            }
          }
        },
        "responses": { "200": { "description": "Rejected" } }
      }
    },
    "/api/v1/shipments/{id}/assignment-preview": {
      "get": {
        "tags": ["Assignment"],
        "summary": "Evaluate Document + Compliance gates for a proposed vehicle/driver pairing from the shipment carrier's own fleet (other ids: 400)",
        "parameters": [
          { "$ref": "#/components/parameters/shipmentId" },
          { "name": "vehicleId", "in": "query", "schema": { "type": "integer" } },
          { "name": "driverId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "documentGate + complianceGate + cargoKg" } }
      }
    },
    "/api/v1/shipments/{id}/assign": {
      "post": {
        "tags": ["Assignment"],
        "summary": "Assign vehicle + driver. Gates must pass or be overridden with an audited reason.",
        "description": "Compliance checks: driver verified & licence valid; vehicle insurance/inspection valid; COMESA Yellow Card valid (cross-border); payload ≤ vehicle capacity; cargo ≤ 56,000 kg EAC GVW limit. Overrides record the exact failures, reason, actor and timestamp in the audit log and on the timeline.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["vehicleId", "driverId"],
                "properties": {
                  "vehicleId": { "type": "integer" },
                  "driverId": { "type": "integer" },
                  "overrideDocumentGate": { "type": "boolean", "default": false },
                  "overrideComplianceGate": { "type": "boolean", "default": false },
                  "overrideReason": { "type": "string", "description": "Required when overriding" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Assigned (execution_assigned)" },
          "400": { "description": "Gate failed and not overridden" }
        }
      }
    },
    "/api/v1/shipments/{id}/events": {
      "get": {
        "tags": ["Events"],
        "summary": "Operational timeline (newest first)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Events", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ShipmentEvent" } } } } } }
      },
      "post": {
        "tags": ["Events"],
        "summary": "Record a manual milestone (who/when/where/evidence). picked_up and arrived_destination advance the lifecycle and are limited to carrier owners/coordinators and the assigned driver.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["eventType"],
                "properties": {
                  "eventType": { "type": "string", "example": "border_cleared" },
                  "occurredAt": { "type": "string", "format": "date-time" },
                  "locationName": { "type": "string" },
                  "notes": { "type": "string" },
                  "metadata": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Event recorded" }, "400": { "description": "Outside the operational window or invalid transition" } }
      }
    },
    "/api/v1/shipments/{id}/pod": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Capture proof of delivery (arrived → delivered; carrier coordinator or assigned driver)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["podRecipientName"], "properties": { "podRecipientName": { "type": "string" }, "podNotes": { "type": "string" } } }
            }
          }
        },
        "responses": { "200": { "description": "Delivered" } }
      }
    },
    "/api/v1/shipments/{id}/complete": {
      "post": {
        "tags": ["Shipments"],
        "summary": "Shipper confirms receipt (delivered → completed). Blocked while exceptions are open.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Completed" }, "400": { "description": "Open exceptions block closure" } }
      }
    },
    "/api/v1/shipments/{id}/payments": {
      "get": {
        "tags": ["Payments"],
        "summary": "Payment ledger (shipper, carrier and agent members, admins; not drivers)",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Payments" } }
      },
      "post": {
        "tags": ["Payments"],
        "summary": "Record an operational payment (carrier/agent coordinator). Proof marks it paid.",
        "description": "JSON, or multipart with an optional proof file (PDF, JPG or PNG, max 10 MB, checked by content) stored privately in Cloudinary.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "amount"],
                "properties": {
                  "type": { "type": "string", "enum": ["delivery_order", "port_fee", "warehouse_fee", "border_fee", "customs_duty", "road_user_charge", "other"] },
                  "amount": { "type": "number" },
                  "currency": { "type": "string", "default": "RWF" },
                  "notes": { "type": "string" }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["type", "amount"],
                "properties": {
                  "type": { "type": "string", "enum": ["delivery_order", "port_fee", "warehouse_fee", "border_fee", "customs_duty", "road_user_charge", "other"] },
                  "amount": { "type": "number" },
                  "currency": { "type": "string", "default": "RWF" },
                  "notes": { "type": "string" },
                  "file": { "type": "string", "format": "binary", "description": "Optional proof of payment" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment recorded (paid when a proof file is attached)" },
          "400": { "description": "Invalid fields, unsupported proof type, content mismatch or over 10 MB" },
          "502": { "description": "The proof file could not be stored" },
          "503": { "description": "File storage is not configured" }
        }
      }
    },
    "/api/v1/shipments/payments/{paymentId}/proof": {
      "get": {
        "tags": ["Payments"],
        "summary": "Short-lived link to view a payment's proof file (shipper, carrier and agent members, admins; not drivers)",
        "parameters": [{ "name": "paymentId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Signed link, valid for 5 minutes",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "expiresAt": { "type": "string", "format": "date-time" }, "fileName": { "type": "string" }, "mimeType": { "type": "string" }, "fileSize": { "type": "integer" } } } } }
          },
          "403": { "description": "Not a party to the shipment" },
          "404": { "description": "Payment not found, or no proof file stored" }
        }
      },
      "post": {
        "tags": ["Payments"],
        "summary": "Upload the proof file for a payment (carrier/agent coordinator); settles it",
        "parameters": [{ "name": "paymentId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "Proof attached; the payment is paid" },
          "400": { "description": "No file, unsupported type, content mismatch or over 10 MB" },
          "403": { "description": "Not a carrier or clearing-agent coordinator on the shipment" },
          "502": { "description": "The proof file could not be stored" },
          "503": { "description": "File storage is not configured" }
        }
      }
    },
    "/api/v1/shipments/payments/{paymentId}/mark-paid": {
      "patch": {
        "tags": ["Payments"],
        "summary": "Settle a pending payment without a proof file",
        "parameters": [{ "name": "paymentId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Paid" } }
      }
    },
    "/api/v1/shipments/{id}/exceptions": {
      "get": {
        "tags": ["Exceptions"],
        "summary": "List exceptions",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "responses": { "200": { "description": "Exceptions" } }
      },
      "post": {
        "tags": ["Exceptions"],
        "summary": "Open an exception (any party incl. the driver). Open exceptions block completion.",
        "parameters": [{ "$ref": "#/components/parameters/shipmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "notes"],
                "properties": {
                  "type": { "type": "string", "enum": ["breakdown", "accident", "theft", "seal_tamper", "customs_hold", "border_queue", "cargo_damage", "other"] },
                  "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "medium" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Exception opened" } }
      }
    },
    "/api/v1/shipments/exceptions/{exceptionId}/resolve": {
      "patch": {
        "tags": ["Exceptions"],
        "summary": "Resolve an exception with notes (carrier coordinator)",
        "parameters": [{ "name": "exceptionId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["resolutionNotes"], "properties": { "resolutionNotes": { "type": "string" } } }
            }
          }
        },
        "responses": { "200": { "description": "Resolved" } }
      }
    },
    "/api/v1/vehicles": {
      "get": { "tags": ["Fleet"], "summary": "Active transport org's fleet", "parameters": [{ "$ref": "#/components/parameters/activeOrg" }], "responses": { "200": { "description": "Vehicles" } } },
      "post": {
        "tags": ["Fleet"],
        "summary": "Register a vehicle with compliance dates (owner/coordinator)",
        "parameters": [{ "$ref": "#/components/parameters/activeOrg" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["plateNumber", "model", "type"],
                "properties": {
                  "plateNumber": { "type": "string" },
                  "model": { "type": "string" },
                  "type": { "type": "string", "enum": ["truck", "van", "trailer", "pickup"] },
                  "capacityKg": { "type": "number" },
                  "insuranceExpiresAt": { "type": "string", "format": "date" },
                  "inspectionExpiresAt": { "type": "string", "format": "date" },
                  "yellowCardExpiresAt": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Vehicle" } }
      }
    },
    "/api/v1/driver/profile": {
      "post": {
        "tags": ["Driver"],
        "summary": "Submit licence for platform verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["licenceNumber"],
                "properties": {
                  "licenceNumber": { "type": "string" },
                  "licenceExpiresAt": { "type": "string", "format": "date" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Pending review" } }
      },
      "get": { "tags": ["Driver"], "summary": "Own licence status", "responses": { "200": { "description": "Driver profile or null" } } }
    },
    "/api/v1/admin/drivers": {
      "get": {
        "tags": ["Admin"],
        "summary": "Driver profiles by review status",
        "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "approved", "rejected"] } }],
        "responses": { "200": { "description": "Driver profiles" } }
      }
    },
    "/api/v1/admin/drivers/{id}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Approve or reject a driver licence",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["approved", "rejected"] } } }
            }
          }
        },
        "responses": { "200": { "description": "Reviewed" } }
      }
    },
    "/api/v1/admin/organizations": {
      "get": { "tags": ["Admin"], "summary": "All organizations", "responses": { "200": { "description": "Organizations" } } }
    },
    "/api/v1/admin/activity-logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "Immutable audit trail (actor, role, org, action, entity, metadata, IP)",
        "parameters": [
          { "name": "entityType", "in": "query", "schema": { "type": "string" } },
          { "name": "entityId", "in": "query", "schema": { "type": "integer" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 500 } }
        ],
        "responses": { "200": { "description": "Audit rows" } }
      }
    },
    "/api/v1/admin/stats": {
      "get": { "tags": ["Admin"], "summary": "Platform counters (users, orgs by type, shipments, open exceptions)", "responses": { "200": { "description": "Stats" } } }
    }
  }
}
