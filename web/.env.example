NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Google Maps (Maps JavaScript + Places (New) + Routes APIs). Restrict the key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling (defaults to Google's demo map ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
